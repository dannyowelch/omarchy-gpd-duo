#!/usr/bin/env bash
# Display layouts and touchpad slider control for the GPD Duo.
# Touch and stylus mapping are out of scope.

set -euo pipefail

PLUGIN_ID="io.github.dannyowelch.gpd-duo"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
STATE_FILE="$STATE_DIR/gpd-duo.json"
MONITORS_LUA="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/monitors.lua"
LAYOUT_TOGGLE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/hypr/gpd-duo-layout.lua"
SLIDERS_TOGGLE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/hypr/gpd-duo-sliders.lua"
GREETER_LUA="/etc/sddm/gpd-duo-hyprland.lua"
GREETER_COMPOSITOR="/etc/sddm/gpd-duo-compositor"
GREETER_SDDM_CONF="/etc/sddm.conf.d/20-gpd-duo.conf"
LIMINE_DROPIN="/etc/limine-entry-tool.d/gpd-duo.conf"
UKI_STAMP="/etc/sddm/gpd-duo-uki.stamp"
LOGIN_FIX_LOG="/var/tmp/gpd-duo-login-fix.log"
PLYMOUTH_THEME_DIR="/usr/share/plymouth/themes/gpd-duo"
UKI_STAMP_VALUE="sddm-greeter-v1-stock-plymouth"
PANEL_ORIENT_PARAM="video=eDP-1:panel_orientation=upside_down"

kernel_rotates_panel() {
  grep -Fq 'panel_orientation=upside_down' /proc/cmdline
}

# Session always uses Hyprland transform 2. Kernel panel_orientation also
# rotates KMS scanout on this AMD panel, so that cmdline must not be live
# at the same time or pixels and the pointer disagree.
lower_transform() {
  echo 2
}

usage() {
  cat <<USAGE
Usage: gpd-duo-ctl <detect|status|apply|save|boot|sliders|login-fix> [arg]

Layout modes: dual, lower
Sliders: on, off, toggle

login-fix writes an SDDM greeter config so the logout screen is
rotated. The first screen after reboot stays stock Omarchy
(lower inverted, lid upright). Prompts for privileges.

The lid display only works while the main (lower) panel is enabled,
so upper-only and tablet layouts are not offered.
USAGE
}

fail() {
  echo "gpd-duo-ctl: $*" >&2
  exit 1
}

# Line-oriented progress for the panel overlay. stderr stays unbuffered
# when piped, unlike stdout, so the overlay can update during limine-update.
emit_progress() {
  local step="$1" label="$2" pct="$3"
  printf 'GPDDUO_PROGRESS\t%s\n' "$(jq -nc \
    --arg step "$step" \
    --arg label "$label" \
    --argjson pct "$pct" \
    '{type:"progress",step:$step,label:$label,pct:$pct}')" >&2
}

need() {
  command -v "$1" >/dev/null || fail "missing $1"
}

dmi() {
  cat "/sys/class/dmi/id/$1" 2>/dev/null || true
}

monitors_json() {
  hyprctl monitors all -j
}

is_stargate() {
  local mons="$1"
  jq -e '
    any(.[];
      ((.make // "") | test("Stargate"; "i"))
      or ((.description // "") | test("Stargate"; "i"))
    )
  ' <<<"$mons" >/dev/null
}

is_duo() {
  local vendor product mons
  vendor=$(dmi sys_vendor)
  product=$(dmi product_name)
  mons=$(monitors_json)

  if [[ $vendor == GPD && $product == G1622* ]]; then
    return 0
  fi
  if [[ $vendor == GPD ]] && is_stargate "$mons"; then
    return 0
  fi
  jq -e 'any(.[]; .name | test("^(eDP|LVDS|DSI)-"))' <<<"$mons" >/dev/null \
    && is_stargate "$mons"
}

pick_lower() {
  jq -c '
    [.[] | select(.name | test("^(eDP|LVDS|DSI)-"))] | .[0] // null
  '
}

pick_upper() {
  local mons="$1"
  local stargate
  stargate=$(jq -c '
    [.[] | select(
      ((.make // "") | test("Stargate"; "i"))
      or ((.description // "") | test("Stargate"; "i"))
    )] | .[0] // null
  ' <<<"$mons")
  if [[ $stargate != null ]]; then
    echo "$stargate"
    return
  fi
  jq -c '
    [.[] | select(.name | test("^DP-"))] | .[0] // null
  ' <<<"$mons"
}

monitor_view() {
  jq -c 'if . == null then null else {
    name, make, description,
    transform, scale, width, height,
    refreshRate, x, y, disabled, focused
  } end'
}

format_refresh() {
  awk -v r="$1" 'BEGIN {
    n = r + 0
    i = int(n + 0.5)
    if ((n - i) < 0.05 && (i - n) < 0.05) printf "%d", i
    else printf "%g", n
  }'
}

logical_size() {
  local width="$1" height="$2" scale="$3" transform="$4"
  awk -v w="$width" -v h="$height" -v s="$scale" -v t="$transform" 'BEGIN {
    if (s <= 0) s = 1
    lw = int(w / s + 0.5)
    lh = int(h / s + 0.5)
    if (t == 1 || t == 3 || t == 5 || t == 7) {
      tmp = lw; lw = lh; lh = tmp
    }
    printf "%d %d", lw, lh
  }'
}

infer_mode() {
  local lower="$1" upper="$2"
  jq -nr --argjson lower "$lower" --argjson upper "$upper" '
    def on($m): $m != null and (($m.disabled // false) | not);
    if on($lower) and (on($upper) | not) then "lower"
    elif on($lower) and on($upper) then "dual"
    else "unknown"
    end
  '
}

read_state() {
  if [[ -f $STATE_FILE ]]; then
    cat "$STATE_FILE"
  else
    echo '{}'
  fi
}

write_state() {
  local last="$1" saved="$2"
  mkdir -p "$STATE_DIR"
  jq -n --argjson current "$(read_state)" --arg last "$last" --arg saved "$saved" \
    '$current + {version:1, lastMode:$last, savedMode:$saved}' >"$STATE_FILE"
}

write_sliders_state() {
  local enabled="$1"
  mkdir -p "$STATE_DIR"
  jq --argjson sliders "$enabled" '. + {version:1, touchpadSliders:$sliders}' \
    <<<"$(read_state)" >"$STATE_FILE"
}

# jq's // treats false as missing, so default only when the key is absent.
sliders_from_state() {
  jq -c 'if (.touchpadSliders | type) == "boolean" then .touchpadSliders else true end' \
    <<<"$(read_state)"
}

# The lower OLED touchpad exposes brightness/volume strips as a sibling
# keyboard (SP3105FT … Keyboard). Hyprland names it like
# sp3105ft:00-0911:5288-keyboard. The "-keyboard-1" pointer is not this.
slider_keyboard() {
  hyprctl devices -j | jq -r '
    [.keyboards[] | .name | select(test("^sp3105ft:.*-keyboard$"))]
    | .[0] // empty
  '
}

write_sliders_overlay() {
  local name="$1"
  mkdir -p "$(dirname "$SLIDERS_TOGGLE")"
  cat >"$SLIDERS_TOGGLE" <<EOF
-- Overlay written by ${PLUGIN_ID}. Loaded after ~/.config/hypr/input.lua.
-- Slider keys are owned by gpd-duo-sliderd, not Omarchy's XF86 binds.
hl.device({ name = "${name}", keybinds = false })
EOF
}

eval_slider_keybinds() {
  local name="$1"
  hyprctl eval "hl.device({ name = \"${name}\", keybinds = false })" >/dev/null
}

apply_sliders() {
  local requested="$1"
  local detect name current next
  detect=$(detect_payload)
  jq -e '.isDuo == true' <<<"$detect" >/dev/null || fail "this machine is not a GPD Duo"
  name=$(slider_keyboard)
  [[ -n $name ]] || fail "could not find the touchpad slider keyboard (SP3105FT)"

  current=$(sliders_from_state)
  case "$requested" in
    true|on|enable|enabled) next=true ;;
    false|off|disable|disabled) next=false ;;
    toggle)
      if [[ $current == true ]]; then next=false; else next=true; fi
      ;;
    *)
      fail "unknown sliders state '$requested' (on, off, toggle)"
      ;;
  esac

  write_sliders_overlay "$name"
  write_sliders_state "$next"
  eval_slider_keybinds "$name" || fail "failed to apply touchpad slider keybinds"
  status_payload
}

boot_sliders() {
  local sliders name
  jq -e '.touchpadSliders | type == "boolean"' <<<"$(read_state)" >/dev/null || return 0
  name=$(slider_keyboard)
  [[ -n $name ]] || return 0
  # Re-read immediately before write so a concurrent toggle is not overwritten
  # by a stale value captured at service start.
  sliders=$(jq -c '.touchpadSliders' <<<"$(read_state)")
  [[ $(jq -r 'type' <<<"$sliders") == boolean ]] || return 0
  write_sliders_overlay "$name"
  eval_slider_keybinds "$name" || true
}

detect_payload() {
  local mons vendor product family lower upper
  vendor=$(dmi sys_vendor)
  product=$(dmi product_name)
  family=$(dmi product_family)
  mons=$(monitors_json)
  lower=$(pick_lower <<<"$mons" | monitor_view)
  upper=$(pick_upper "$mons" | monitor_view)

  jq -n \
    --argjson isDuo "$(is_duo && echo true || echo false)" \
    --arg vendor "$vendor" \
    --arg product "$product" \
    --arg family "$family" \
    --argjson lower "$lower" \
    --argjson upper "$upper" \
    '{isDuo:$isDuo, vendor:$vendor, product:$product, family:$family, lower:$lower, upper:$upper}'
}

status_payload() {
  local detect mode last saved sliders slider_dev login_fixed
  detect=$(detect_payload)
  mode=$(infer_mode "$(jq -c '.lower' <<<"$detect")" "$(jq -c '.upper' <<<"$detect")")
  last=$(jq -r '.lastMode // ""' <<<"$(read_state)")
  saved=$(jq -r '.savedMode // ""' <<<"$(read_state)")
  sliders=$(sliders_from_state)
  slider_dev=$(slider_keyboard)
  if login_is_fixed; then login_fixed=true; else login_fixed=false; fi
  local needs_reboot=false
  if [[ $login_fixed == true ]] && kernel_rotates_panel; then
    needs_reboot=true
  fi
  jq -n \
    --argjson detect "$detect" \
    --arg mode "$mode" \
    --arg lastMode "$last" \
    --arg savedMode "$saved" \
    --argjson touchpadSliders "$sliders" \
    --arg sliderDevice "$slider_dev" \
    --argjson loginFixed "$login_fixed" \
    --argjson loginFixNeedsReboot "$needs_reboot" \
    '$detect + {
      mode:$mode,
      lastMode:$lastMode,
      savedMode:$savedMode,
      saved:($savedMode != "" and $savedMode == $lastMode and $lastMode == $mode),
      touchpadSliders:$touchpadSliders,
      sliderDevice:(if $sliderDevice == "" then null else $sliderDevice end),
      loginFixed:$loginFixed,
      loginFixNeedsReboot:$loginFixNeedsReboot
    }'
}

write_layout_overlay() {
  local body="$1"
  mkdir -p "$(dirname "$LAYOUT_TOGGLE")"
  cat >"$LAYOUT_TOGGLE" <<EOF
-- Overlay written by ${PLUGIN_ID}. Loaded after ~/.config/hypr/monitors.lua.
$body
EOF
  hyprctl reload >/dev/null
}

wait_for_mode() {
  local expected="$1"
  local i detect mode
  for i in 1 2 3 4 5 6 7 8; do
    detect=$(detect_payload)
    mode=$(infer_mode "$(jq -c '.lower' <<<"$detect")" "$(jq -c '.upper' <<<"$detect")")
    if [[ $mode == "$expected" ]]; then
      return 0
    fi
    sleep 0.15
  done
  return 1
}

geometry() {
  local mon="$1"
  local width height refresh scale transform
  width=$(jq -r '.width' <<<"$mon")
  height=$(jq -r '.height' <<<"$mon")
  refresh=$(format_refresh "$(jq -r '.refreshRate' <<<"$mon")")
  scale=$(jq -r '.scale' <<<"$mon")
  transform=$(jq -r '.transform' <<<"$mon")
  if [[ $width == null || $width -le 0 ]]; then
    width=2880
    height=1800
    refresh=60
  fi
  if [[ $scale == null || $scale == 0 ]]; then
    scale=2
  else
    scale=$(awk -v s="$scale" 'BEGIN { printf "%g", s + 0 }')
  fi
  echo "$width" "$height" "$refresh" "$scale" "$transform"
}

apply_mode() {
  local requested="$1"
  local detect lower upper
  detect=$(detect_payload)
  jq -e '.isDuo == true' <<<"$detect" >/dev/null || fail "this machine is not a GPD Duo"
  lower=$(jq -c '.lower' <<<"$detect")
  upper=$(jq -c '.upper' <<<"$detect")
  [[ $lower != null ]] || fail "could not find the lower display (eDP)"
  [[ $upper != null ]] || fail "could not find the upper display (Stargate / DP)"

  local lname uname
  local lw lh lr ls lt
  local uw uh ur us ut
  lname=$(jq -r '.name' <<<"$lower")
  uname=$(jq -r '.name' <<<"$upper")
  read -r lw lh lr ls lt <<<"$(geometry "$lower")"
  read -r uw uh ur us ut <<<"$(geometry "$upper")"

  local scale
  scale=$(awk -v a="$ls" -v b="$us" 'BEGIN { s = a + 0; if (s <= 0) s = b + 0; if (s <= 0) s = 2; printf "%g", s }')

  local lmode umode
  lmode="${lw}x${lh}@${lr}"
  umode="${uw}x${uh}@${ur}"

  local l_transform stack_y overlay
  l_transform=$(lower_transform)
  read -r _ stack_y <<<"$(logical_size "$lw" "$lh" "$scale" "$l_transform")"

  # hyprctl eval cannot re-enable a disabled output under Omarchy's Lua
  # parser. Write a toggle overlay (sourced after monitors.lua) and reload.
  case "$requested" in
    dual)
      overlay=$(
        lua_monitor "$lname" false "$lmode" "0x0" "$scale" "$l_transform"
        lua_monitor "$uname" false "$umode" "0x-${stack_y}" "$scale" 0
      )
      ;;
    lower)
      overlay=$(
        lua_monitor "$lname" false "$lmode" "0x0" "$scale" "$l_transform"
        lua_monitor "$uname" true
      )
      ;;
    upper|tablet)
      fail "mode '$requested' is disabled: the lid display only works while the main panel is on"
      ;;
    *)
      fail "unknown mode '$requested' (dual, lower)"
      ;;
  esac

  write_layout_overlay "$overlay"
  if ! wait_for_mode "$requested"; then
    fail "failed to apply $requested (lid display did not reach the expected state)"
  fi

  local saved
  saved=$(jq -r '.savedMode // ""' <<<"$(read_state)")
  write_state "$requested" "$saved"
  status_payload
}

lua_monitor() {
  local name="$1" disabled="$2"
  if [[ $disabled == true ]]; then
    printf 'hl.monitor({ output = "%s", disabled = true })\n' "$name"
    return
  fi
  local mode="$3" position="$4" scale_var="$5" transform="${6:-}"
  local extra=""
  if [[ -n $transform && $transform != 0 ]]; then
    extra=$(printf ', transform = %s' "$transform")
  fi
  printf 'hl.monitor({ output = "%s", mode = "%s", position = "%s", scale = %s%s })\n' \
    "$name" "$mode" "$position" "$scale_var" "$extra"
}

lua_other_monitors() {
  local mons="$1" lower_name="$2" upper_name="$3" scale_var="$4"
  local mon name disabled width height refresh scale transform x y mode pos
  while IFS= read -r mon; do
    [[ -n $mon ]] || continue
    name=$(jq -r '.name' <<<"$mon")
    disabled=$(jq -r '.disabled // false' <<<"$mon")
    if [[ $disabled == true ]]; then
      lua_monitor "$name" true
      continue
    fi
    width=$(jq -r '.width' <<<"$mon")
    height=$(jq -r '.height' <<<"$mon")
    refresh=$(format_refresh "$(jq -r '.refreshRate' <<<"$mon")")
    scale=$(jq -r '.scale' <<<"$mon")
    transform=$(jq -r '.transform // 0' <<<"$mon")
    x=$(jq -r '.x' <<<"$mon")
    y=$(jq -r '.y' <<<"$mon")
    mode="${width}x${height}@${refresh}"
    pos="${x}x${y}"
    if [[ $scale == null || $scale == 0 ]]; then
      lua_monitor "$name" false "$mode" "$pos" "$scale_var" "$transform"
    else
      printf 'hl.monitor({ output = "%s", mode = "%s", position = "%s", scale = %s' \
        "$name" "$mode" "$pos" "$scale"
      if [[ $transform != 0 ]]; then
        printf ', transform = %s' "$transform"
      fi
      printf ' })\n'
    fi
  done < <(jq -c --arg lower "$lower_name" --arg upper "$upper_name" '
    .[] | select(.name != $lower and .name != $upper)
  ' <<<"$mons")
}

save_layout() {
  local detect mode last
  detect=$(detect_payload)
  jq -e '.isDuo == true' <<<"$detect" >/dev/null || fail "this machine is not a GPD Duo"
  last=$(jq -r '.lastMode // ""' <<<"$(read_state)")
  mode=$(infer_mode "$(jq -c '.lower' <<<"$detect")" "$(jq -c '.upper' <<<"$detect")")
  if [[ $last == dual || $last == lower ]]; then
    mode=$last
  fi
  [[ $mode == dual || $mode == lower ]] || fail "could not infer a layout to save; apply dual or lower first"

  # Re-apply so live Hyprland and the file agree, then persist.
  apply_mode "$mode" >/dev/null

  detect=$(detect_payload)
  local lower upper lname uname mons
  lower=$(jq -c '.lower' <<<"$detect")
  upper=$(jq -c '.upper' <<<"$detect")
  lname=$(jq -r '.name' <<<"$lower")
  uname=$(jq -r '.name' <<<"$upper")
  mons=$(monitors_json)

  local lw lh lr ls lt
  local uw uh ur us ut
  read -r lw lh lr ls lt <<<"$(geometry "$lower")"
  read -r uw uh ur us ut <<<"$(geometry "$upper")"
  local scale
  scale=$(awk -v a="$ls" -v b="$us" 'BEGIN { s = a + 0; if (s <= 0) s = b + 0; if (s <= 0) s = 2; printf "%g", s }')
  local gdk
  gdk=$(awk -v s="$scale" 'BEGIN { printf "%d", int(s + 0.5) }')
  local l_transform stack_y
  l_transform=$(lower_transform)
  read -r _ stack_y <<<"$(logical_size "$lw" "$lh" "$scale" "$l_transform")"

  local l_disabled u_disabled u_transform l_pos u_pos
  case "$mode" in
    dual)
      l_disabled=false; u_disabled=false
      u_transform=0
      l_pos="0x0"; u_pos="0x-${stack_y}"
      ;;
    lower)
      l_disabled=false; u_disabled=true
      u_transform=0
      l_pos="0x0"; u_pos="0x0"
      ;;
    *)
      fail "cannot save mode '$mode'"
      ;;
  esac

  mkdir -p "$(dirname "$MONITORS_LUA")"
  if [[ -f $MONITORS_LUA ]]; then
    cp -a "$MONITORS_LUA" "$MONITORS_LUA.bak.$(date +%s)"
  fi

  {
    cat <<EOF
-- Written by ${PLUGIN_ID}. Use the GPD Duo plugin to change layouts.
-- A timestamped backup of the previous file is kept next to this one.

local omarchy_gdk_scale = ${gdk}
local omarchy_monitor_scale = ${scale}

hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))
EOF
    lua_monitor "$lname" "$l_disabled" "${lw}x${lh}@${lr}" "$l_pos" "omarchy_monitor_scale" "$l_transform"
    lua_monitor "$uname" "$u_disabled" "${uw}x${uh}@${ur}" "$u_pos" "omarchy_monitor_scale" "$u_transform"
    extra=$(lua_other_monitors "$mons" "$lname" "$uname" "omarchy_monitor_scale")
    if [[ -n $extra ]]; then
      printf '\n-- Other displays present when this layout was saved.\n'
      printf '%s\n' "$extra"
    fi
  } >"$MONITORS_LUA"

  write_state "$mode" "$mode"
  status_payload
}

boot() {
  is_duo || exit 0
  local detect lower transform last saved want mode
  detect=$(detect_payload)
  lower=$(jq -c '.lower' <<<"$detect")
  [[ $lower != null ]] || exit 0
  transform=$(jq -r '.transform // 0' <<<"$lower")
  saved=$(jq -r '.savedMode // ""' <<<"$(read_state)")
  last=$(jq -r '.lastMode // ""' <<<"$(read_state)")
  want=$(lower_transform)

  # Do not apply transform 2 while the kernel is still rotating scanout;
  # that combination inverts the image. Heal on the next boot after the
  # panel_orientation cmdline is gone.
  if kernel_rotates_panel; then
    boot_sliders
    return
  fi

  if [[ $transform != "$want" ]]; then
    mode=$last
    if [[ $mode != dual && $mode != lower ]]; then
      mode=$saved
    fi
    if [[ $mode != dual && $mode != lower ]]; then
      mode=$(infer_mode "$(jq -c '.lower' <<<"$detect")" "$(jq -c '.upper' <<<"$detect")")
    fi
    if [[ $mode == dual || $mode == lower ]]; then
      if [[ $saved == dual || $saved == lower ]]; then
        save_layout >/dev/null
      else
        apply_mode "$mode" >/dev/null
      fi
    elif [[ -z $saved && -z $last ]]; then
      if jq -e '.disabled | not' <<<"$lower" >/dev/null; then
        apply_mode dual >/dev/null
      fi
    fi
  fi

  boot_sliders
}

login_is_fixed() {
  [[ -f $GREETER_LUA && -f $GREETER_SDDM_CONF ]] || return 1
  grep -Fq 'transform = 2' "$GREETER_LUA" || return 1
  grep -Fq "$GREETER_LUA" "$GREETER_SDDM_CONF" || return 1
  if [[ -f $LIMINE_DROPIN ]] && grep -Fq "$PANEL_ORIENT_PARAM" "$LIMINE_DROPIN"; then
    return 1
  fi
  if grep -Fq 'Theme=gpd-duo' /etc/plymouth/plymouthd.conf 2>/dev/null; then
    return 1
  fi
  [[ ! -d $PLYMOUTH_THEME_DIR ]] || return 1
  return 0
}

restore_plymouth_default() {
  local changed=false
  if grep -Fq 'Theme=gpd-duo' /etc/plymouth/plymouthd.conf 2>/dev/null; then
    command -v plymouth-set-default-theme >/dev/null || fail "plymouth-set-default-theme is missing"
    plymouth-set-default-theme omarchy
    changed=true
  fi
  if [[ -e $PLYMOUTH_THEME_DIR ]]; then
    rm -rf "$PLYMOUTH_THEME_DIR"
    changed=true
  fi
  [[ $changed == true ]]
}

login_progress_from_limine() {
  local line="$1"
  case "$line" in
    *"Running build hook"*)
      LOGIN_FIX_HOOK_PCT=${LOGIN_FIX_HOOK_PCT:-55}
      LOGIN_FIX_HOOK_PCT=$((LOGIN_FIX_HOOK_PCT + 2))
      if (( LOGIN_FIX_HOOK_PCT > 82 )); then LOGIN_FIX_HOOK_PCT=82; fi
      local hook
      hook=$(sed -n 's/.*\[\(.*\)\].*/\1/p' <<<"$line" | tail -n 1)
      emit_progress uki "Initramfs: ${hook:-running hooks}" "$LOGIN_FIX_HOOK_PCT"
      ;;
    *"limine-install"*|*"Installing Limine"*|*"Limine binaries"*)
      emit_progress uki "Installing bootloader" 45
      ;;
    *"Building image"*|*"Starting build"*)
      emit_progress uki "Building initramfs" 55
      ;;
    *"UKI"*|*"unified kernel"*|*"Creating zstd"*|*"Creating gzip"*)
      emit_progress uki "Creating boot image" 88
      ;;
    *"Image generation successful"*|*"Image generated"*)
      emit_progress uki "Boot image ready" 94
      ;;
  esac
}

run_limine_update() {
  local status
  emit_progress uki "Rebuilding boot image" 40
  LOGIN_FIX_HOOK_PCT=55

  set +o pipefail
  if command -v stdbuf >/dev/null; then
    stdbuf -oL -eL limine-update 2>&1
  else
    limine-update 2>&1
  fi | tee "$LOGIN_FIX_LOG" | while IFS= read -r line || [[ -n $line ]]; do
    login_progress_from_limine "$line"
  done
  status=${PIPESTATUS[0]}
  set -o pipefail

  if [[ $status -ne 0 ]]; then
    fail "boot image rebuild failed"
  fi
  emit_progress uki "Boot image rebuilt" 96
}

# Always dual: both OLEDs on, lower rotated 180°, same scale. SDDM's greeter
# Hyprland does not read monitors.lua, so the session layout never applies.
generate_greeter_lua() {
  local detect lower upper lname uname
  detect=$(detect_payload)
  jq -e '.isDuo == true' <<<"$detect" >/dev/null || fail "this machine is not a GPD Duo"
  lower=$(jq -c '.lower' <<<"$detect")
  upper=$(jq -c '.upper' <<<"$detect")
  [[ $lower != null ]] || fail "could not find the lower display (eDP)"
  [[ $upper != null ]] || fail "could not find the upper display (Stargate / DP)"

  local lw lh lr ls lt uw uh ur us ut scale stack_y
  lname=$(jq -r '.name' <<<"$lower")
  uname=$(jq -r '.name' <<<"$upper")
  read -r lw lh lr ls lt <<<"$(geometry "$lower")"
  read -r uw uh ur us ut <<<"$(geometry "$upper")"
  scale=$(awk -v a="$ls" -v b="$us" 'BEGIN { s = a + 0; if (s <= 0) s = b + 0; if (s <= 0) s = 2; printf "%g", s }')
  read -r _ stack_y <<<"$(logical_size "$lw" "$lh" "$scale" 2)"

  cat <<EOF
-- Written by ${PLUGIN_ID}. SDDM greeter compositor config for the GPD Duo.
-- The lower OLED is physically inverted. Both panels get the same scale
-- because the lid EDID reports a different size than the main panel.

hl.config({
  misc = {
    disable_hyprland_logo = true,
    disable_splash_rendering = true,
    force_default_wallpaper = 0,
  },
  animations = {
    enabled = false,
  },
})

EOF
  lua_monitor "$lname" false "${lw}x${lh}@${lr}" "0x0" "$scale" 2
  lua_monitor "$uname" false "${uw}x${uh}@${ur}" "0x-${stack_y}" "$scale" 0
  printf 'hl.monitor({ output = "", mode = "preferred", position = "auto", scale = %s })\n' "$scale"
}

self_path() {
  readlink -f "$0"
}

# Root-only. Writes the SDDM greeter config and restores stock Plymouth
# if a Duo splash was previously installed. Called via pkexec/sudo.
login_install() {
  local src="${1:-}"
  [[ $EUID -eq 0 ]] || fail "login-install must run as root"
  [[ -n $src && -f $src ]] || fail "login-install requires a greeter config file"

  mkdir -p /etc/sddm /etc/sddm.conf.d
  emit_progress greeter "Writing greeter config" 22
  install -m 644 "$src" "$GREETER_LUA"
  rm -f "$GREETER_COMPOSITOR"
  cat >"$GREETER_SDDM_CONF" <<EOF
# Written by ${PLUGIN_ID}.
[Wayland]
CompositorCommand=start-hyprland -- --config ${GREETER_LUA}
EOF
  chmod 644 "$GREETER_SDDM_CONF"

  local rebuild=false
  emit_progress plymouth "Restoring default boot splash" 32
  if restore_plymouth_default; then
    rebuild=true
  fi
  if [[ -f $LIMINE_DROPIN ]]; then
    rm -f "$LIMINE_DROPIN"
    rebuild=true
  fi
  if [[ ! -f $UKI_STAMP || $(cat "$UKI_STAMP") != "$UKI_STAMP_VALUE" ]]; then
    rebuild=true
  fi
  if [[ $rebuild == false ]]; then
    emit_progress done "Logout greeter is fixed." 100
    return 0
  fi
  command -v limine-update >/dev/null || fail "limine-update is missing; cannot restore the default boot splash"
  run_limine_update
  printf '%s\n' "$UKI_STAMP_VALUE" >"$UKI_STAMP"
  chmod 644 "$UKI_STAMP"
  emit_progress done "Restored the default boot splash. Reboot once." 100
}

run_elevated() {
  local self
  self=$(self_path)
  if [[ $EUID -eq 0 ]]; then
    fail "run login-fix as your user; it will prompt for privileges"
  fi
  if [[ -t 0 && -t 1 ]] && command -v sudo >/dev/null; then
    sudo "$self" "$@"
  else
    command -v pkexec >/dev/null || fail "need pkexec or sudo to install the login screen fix"
    pkexec "$self" "$@"
  fi
}

login_fix() {
  local tmp
  [[ $EUID -ne 0 ]] || fail "run login-fix as your user; it will prompt for privileges"

  emit_progress auth "Waiting for authentication" 8
  tmp=$(mktemp /tmp/gpd-duo-greeter.XXXXXX.lua)
  if ! generate_greeter_lua >"$tmp"; then
    rm -f "$tmp"
    fail "could not generate the login screen config"
  fi
  emit_progress install "Installing greeter config" 16
  if ! run_elevated login-install "$tmp"; then
    rm -f "$tmp"
    fail "authentication cancelled or install failed"
  fi
  rm -f "$tmp"
  status_payload
}

need hyprctl
need jq

cmd="${1:-}"
case "$cmd" in
  detect) detect_payload | jq -c . ;;
  status) status_payload | jq -c . ;;
  apply)
    [[ -n ${2:-} ]] || fail "apply requires a mode"
    apply_mode "$2" | jq -c .
    ;;
  save) save_layout | jq -c . ;;
  sliders)
    [[ -n ${2:-} ]] || fail "sliders requires on, off, or toggle"
    apply_sliders "$2" | jq -c .
    ;;
  boot) boot ;;
  login-preview) generate_greeter_lua ;;
  login-fix) login_fix | jq -c . ;;
  login-install)
    login_install "${2:-}"
    ;;
  -h|--help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
